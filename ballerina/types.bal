# Represents the Queries record for the operation: getBitlinksByGroup
public type GetBitlinksByGroupQueries record {
    # The hostname and/or path you would like to search (case-insensitive). Subdomains included; query params and fragment ignored
    @http:Query {name: "hostname_path_query"}
    string hostnamePathQuery?;
    # Filter to return only links for the given channel GUID, can be provided, overrides all other parameters
    @http:Query {name: "channel_guid"}
    string channelGuid?;
    # Timestamp as an integer unix epoch (seconds only)
    @http:Query {name: "created_after"}
    int createdAfter?;
    # Filter to only Bitlinks that contain deeplinks
    "on"|"off"|"both" deeplinks = "both";
    # The value that you would like to search
    string query?;
    # a filter value if the resource has any QR codes
    @http:Query {name: "has_qr_codes"}
    "on"|"off"|"both" hasQrCodes = "both";
    # Filter to only Bitlinks that contain deeplinks configured with a custom domain
    @http:Query {name: "domain_deeplinks"}
    "on"|"off"|"both" domainDeeplinks = "both";
    # Filter by the login of the authenticated user that created the Bitlink
    @http:Query {name: "encoding_login"}
    string[] encodingLogin?;
    # Filter by given tags
    string[] tags?;
    # Filter to return only links for the given campaign GUID, can be provided
    @http:Query {name: "campaign_guid"}
    string campaignGuid?;
    # Filter by launchpad id
    @http:Query {name: "launchpad_ids"}
    string[] launchpadIds?;
    # Token used to search next batch, only use response from API as input value
    @http:Query {name: "search_after"}
    string searchAfter?;
    # Whether or not to include archived resources
    "on"|"off"|"both" archived = "off";
    # filter bitlinks by expiration status
    @http:Query {name: "is_expired"}
    "on"|"off"|"both" isExpired = "both";
    # filter bitlinks by presence of dynamic routing rules
    @http:Query {name: "has_dynamic_routing"}
    "on"|"off"|"both" hasDynamicRouting = "both";
    # The quantity of items to be be returned
    int size = 50;
    # Timestamp as an integer unix epoch (seconds only)
    @http:Query {name: "created_before"}
    int createdBefore?;
    # filter bitlinks by presence of expiration
    @http:Query {name: "has_expiration"}
    "on"|"off"|"both" hasExpiration = "both";
    # Filter Bitlinks by whether they have a custom Bitlink: on, off or both
    @http:Query {name: "custom_bitlink"}
    "on"|"off"|"both" customBitlink = "both";
};

