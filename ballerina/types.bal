# information about given custom domain
public type CustomDomainBody record {
    # Whether the custom domain is active
    @jsondata:Name {value: "is_active"}
    boolean isActive?;
    # URL that unknown back-halves on the domain redirect to
    @jsondata:Name {value: "wildcard_redirect"}
    string wildcardRedirect?;
    # ISO_TIMESTAMP
    string created?;
    # Error found during domain validation, if any
    @jsondata:Name {value: "validation_error"}
    string validationError?;
    # Whether HTTP Strict Transport Security is enabled for the domain
    @jsondata:Name {value: "hsts_enabled"}
    boolean hstsEnabled?;
    # URL that the root of the domain redirects to
    @jsondata:Name {value: "root_redirect"}
    string rootRedirect?;
    # GUIDs of the groups that can use the custom domain
    @jsondata:Name {value: "group_guids"}
    string[] groupGuids?;
    # Deep link apps configured for the domain
    @jsondata:Name {value: "deeplink_apps"}
    MinimalDeeplinkApp[] deeplinkApps?;
    # Time of the last DNS configuration check
    @jsondata:Name {value: "configuration_last_check_ts"}
    string configurationLastCheckTs?;
    # Whether HTTPS is enabled for the domain
    @jsondata:Name {value: "https_enabled"}
    boolean httpsEnabled?;
    # Error found while configuring the SSL certificate, if any
    @jsondata:Name {value: "ssl_configuration_error"}
    string sslConfigurationError?;
    # Whether the automatic SSL configuration failed
    @jsondata:Name {value: "ssl_autoconfigure_error"}
    boolean sslAutoconfigureError?;
    # Result of the domain validation: ok, pending or error
    @jsondata:Name {value: "validation_status"}
    "ok"|"pending"|"error" validationStatus?;
    # Whether browsers are told to upgrade insecure requests to HTTPS
    @jsondata:Name {value: "upgrade_insecure_requests"}
    boolean upgradeInsecureRequests?;
    # The custom domain name
    @jsondata:Name {value: "custom_domain"}
    string customDomain?;
    # Whether Bitlinks on the domain are served over HTTPS
    @jsondata:Name {value: "https_bitlinks"}
    boolean httpsBitlinks?;
    # SSL certificate in use on the domain
    @jsondata:Name {value: "ssl_cert"}
    PublicSSLCert sslCert?;
};

