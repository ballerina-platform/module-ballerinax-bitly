    @jsondata:Name {value: "background_color"}
    string backgroundColor?;
    # Shape of the dots that make up the QR code
    @jsondata:Name {value: "dot_pattern_type"}
    QRCodeDotPatternType dotPatternType?;
    # Gradient applied to the QR code dots
    QRCodeGradient gradient?;
    # Gradient applied to the QR code background
    @jsondata:Name {value: "background_gradient"}
    QRCodeGradient backgroundGradient?;
    # Whether the QR code carries Bitly branding
    QRCodeBranding branding?;
    # Logo placed in the center of the QR code
    QRCodeLogoPublic logo?;
    # QR code specification settings, such as the error correction level
    @jsondata:Name {value: "spec_settings"}
    QRCodeSpecSettingsPublic specSettings?;
    # The QR code's dot pattern color in hex code format
    @jsondata:Name {value: "dot_pattern_color"}
    string dotPatternColor?;
    # Contains the center, top, and bottom text to be used in the QR code
    QRCodeText text?;
    # Frame drawn around the QR code
    QRCodeFrameRequest frame?;
};

