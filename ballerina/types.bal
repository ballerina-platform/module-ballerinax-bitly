# Customization and content values for a QR code created through the public API
public type PublicUpdateQRCodeRequest record {
    # A boolean representing if the QR code has been archived
    boolean archived?;
    # Options that control how the QR code looks
    @jsondata:Name {value: "render_customizations"}
    QRCodeCustomizationsPublic renderCustomizations?;
    # Dynamic routing rules for this QR code. Providing this field replaces all existing rules. Send an empty array to clear all rules
    @jsondata:Name {value: "dynamic_routing"}
    DynamicRoutingRule[] dynamicRouting?;
    # New title of the QR code
    string title?;
    # Optional expiration timestamp for the QR code's bitlink (e.g., 2025-01-28T14:30:00+0000). Minimum expiration time is 5 minutes from now and maximum is 1 year
    @jsondata:Name {value: "expiration_at"}
    string expirationAt?;
    # A list of tags to add to the QR code
    string[] tags?;
};

# Represents the Queries record for the operation: listQRMinimal
public type ListQRMinimalQueries record {
    # The hostname and/or path you would like to search (case-insensitive). Subdomains included; query params and fragment ignored
    @http:Query {name: "hostname_path_query"}
    string hostnamePathQuery?;
    # Timestamp as an integer unix epoch (seconds only)
    @http:Query {name: "created_after"}
    int createdAfter?;
    # The value that you would like to search
    string query?;
    # Whether or not QRCode has any render customizations (like color or shape changes)
    @http:Query {name: "has_render_customizations"}
    "on"|"off"|"both" hasRenderCustomizations = "both";
    # Filter by given tags
    string[] tags?;
    # Token used to search next batch of qr codes, only use response from API as input value
    @http:Query {name: "search_after"}
    string searchAfter?;
    # Whether or not to include archived resources
    "on"|"off"|"both" archived = "off";
    # filter bitlinks by expiration status
    @http:Query {name: "is_expired"}
    "on"|"off"|"both" isExpired = "both";
    # filter bitlinks by presence of dynamic routing rules
    @http:Query {name: "has_dynamic_routing"}
    "on"|"off"|"both" hasDynamicRouting = "both";
    # The quantity of items to be be returned
    int size = 50;
    # Timestamp as an integer unix epoch (seconds only)
    @http:Query {name: "created_before"}
    int createdBefore?;
    # filter bitlinks by presence of expiration
    @http:Query {name: "has_expiration"}
    "on"|"off"|"both" hasExpiration = "both";
    # Filter by the login of the authenticated user that created the QR Code
    @http:Query {name: "creating_login"}
    string[] creatingLogin?;
    # Filter QR codes by the type of destination they point to: bitlink or long_url
    @http:Query {name: "qrc_type"}
    ("bitlink"|"long_url")[] qrcType = ["bitlink","long_url"];
    # a filter value if the resource is a GS1 QR code
    @http:Query {name: "is_gs1"}
    "on"|"off"|"both" isGs1 = "both";
};

