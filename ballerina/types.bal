# Represents the Queries record for the operation: getChannels
public type GetChannelsQueries record {
    # A GUID for a Bitly campaign
    @http:Query {name: "campaign_guid"}
    string campaignGuid?;
    # A GUID for a Bitly group
    @http:Query {name: "group_guid"}
    string groupGuid?;
};

public type BitlySiteContent record {
    string description?;
    @jsondata:Name {value: "display_name"}
    string displayName?;
};

# Enum of banner type options on a Bitly Site
public type SiteBannerType "none"|"hero"|"rounded_up"|"gradient"|"square"|"frame";

public type SiteBlockRequest record {
    string parent?;
    TextBlockAppearanceRequest appearance?;
    @jsondata:Name {value: "is_active"}
    boolean isActive?;
    @jsondata:Name {value: "schedule_end"}
    string scheduleEnd?;
    SiteContentUnion content?;
    @jsondata:Name {value: "schedule_start"}
    string scheduleStart?;
    @jsondata:Name {value: "is_pinned"}
    boolean isPinned?;
};
